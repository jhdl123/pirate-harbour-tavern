"value": 0.65
}, {
"label": "Weather: heavy storm",
"operation": "MULTIPLY",
"target": "customer_stay_duration",
"value": 1.4
}, {
"label": "Weather: heavy storm",
"operation": "MULTIPLY",
"target": "delivery_speed",
"value": 0.6
}]
