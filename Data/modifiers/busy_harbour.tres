"operation": "MULTIPLY",
"target": "customer_arrival_rate",
"value": 1.75
}, {
"label": "Event: harbour festival",
"operation": "MULTIPLY",
"target": "customer_group_size",
"value": 1.3
}, {
"label": "Event: harbour festival",
"operation": "MULTIPLY",
"target": "customer_drink_consumption",
"value": 1.25
}, {
"label": "Event: harbour festival",
"operation": "MULTIPLY",
"target": "customer_spending",
"value": 1.1
}]
