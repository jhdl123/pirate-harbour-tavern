[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"social_visit"
display_name = "Social Visit"
description = "Here for the company."
enabled = true
visit_duration_multiplier = 1.2
drink_count_multiplier = 1.1
reorder_multiplier = 1.1
sociability_offset = 0.3
entertainment_offset = 0.1
privacy_offset = -0.2
group_cohesion_multiplier = 1.0
activity_score_offsets = {"socialise_at_seat": 10.0, "relax_at_seat": 3.0, "leave": -3.0}
dissatisfaction_departure_multiplier = 0.9
topic_tags = Array[StringName]([&"gossip", &"local_news"])
