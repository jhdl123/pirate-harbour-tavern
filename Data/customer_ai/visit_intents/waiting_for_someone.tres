[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"waiting_for_someone"
display_name = "Waiting"
description = "Expecting company."
enabled = true
visit_duration_multiplier = 1.1
drink_count_multiplier = 0.8
reorder_multiplier = 0.7
sociability_offset = -0.1
entertainment_offset = -0.1
privacy_offset = 0.2
group_cohesion_multiplier = 1.0
activity_score_offsets = {"relax_at_seat": 9.0, "wander": -5.0, "leave": -4.0}
dissatisfaction_departure_multiplier = 1.2
topic_tags = Array[StringName]([&"arrivals"])
