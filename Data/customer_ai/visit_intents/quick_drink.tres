[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"quick_drink"
display_name = "Quick Drink"
description = "In and out - one drink, no fuss."
enabled = true
visit_duration_multiplier = 0.5
drink_count_multiplier = 0.6
reorder_multiplier = 0.5
sociability_offset = -0.1
entertainment_offset = -0.2
privacy_offset = 0.1
group_cohesion_multiplier = 1.0
activity_score_offsets = {"leave": 8.0, "wander": -6.0, "visit_tavern_activity": -8.0}
dissatisfaction_departure_multiplier = 1.4
topic_tags = Array[StringName]([&"local_news"])
