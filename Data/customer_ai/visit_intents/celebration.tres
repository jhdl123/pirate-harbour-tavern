entertainment_offset = 0.35
privacy_offset = -0.3
group_cohesion_multiplier = 1.4
activity_score_offsets = {"socialise_at_seat": 10.0, "visit_tavern_activity": 8.0, "leave": -6.0}
dissatisfaction_departure_multiplier = 0.6
topic_tags = Array[StringName]([&"celebration"])
