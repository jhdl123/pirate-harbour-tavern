[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"celebration"
display_name = "Celebration"
description = "Something worth marking."
enabled = true
visit_duration_multiplier = 1.5
drink_count_multiplier = 1.8
reorder_multiplier = 1.6
