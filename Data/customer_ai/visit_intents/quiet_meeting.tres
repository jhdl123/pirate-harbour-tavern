[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"quiet_meeting"
display_name = "Quiet Meeting"
description = "Business, discreetly."
enabled = true
visit_duration_multiplier = 0.9
drink_count_multiplier = 0.7
reorder_multiplier = 0.6
sociability_offset = -0.35
entertainment_offset = -0.35
privacy_offset = 0.45
group_cohesion_multiplier = 1.2
activity_score_offsets = {"relax_at_seat": 8.0, "socialise_at_seat": -6.0, "visit_tavern_activity": -10.0, "wander": -8.0}
dissatisfaction_departure_multiplier = 1.5
topic_tags = Array[StringName]([&"business", &"contracts"])
