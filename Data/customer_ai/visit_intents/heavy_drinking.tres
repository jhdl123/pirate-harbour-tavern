[gd_resource type="Resource" script_class="VisitIntentConfig" format=3]

[ext_resource type="Script" path="res://systems/customer_ai/identity/visit_intent_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
intent_id = &"heavy_drinking"
display_name = "Heavy Drinking"
description = "Drinking seriously tonight."
enabled = true
visit_duration_multiplier = 1.4
drink_count_multiplier = 2.0
reorder_multiplier = 1.8
sociability_offset = 0.1
entertainment_offset = 0.0
privacy_offset = -0.1
group_cohesion_multiplier = 1.1
activity_score_offsets = {"order_drink": 8.0, "drink": 4.0, "visit_tavern_activity": -3.0}
dissatisfaction_departure_multiplier = 0.7
topic_tags = Array[StringName]([&"drink"])
