	"tasks": [
		{
			"uuid": "045980ae-6ca3-4760-91a5-a98bdfadb3d1",
			"title": "Complete daily-cycle HUD and state display",
			"description": "Expose the existing lifecycle as a clear player-facing feature.\n\nShow preparation, open, last orders, closing and closed states. Include countdowns to the next lifecycle transition and clear guidance during the preparation period.",
			"category": "7f7c593f-f186-492d-ae50-28de1a5086f9",
			"steps": [
				"Opening-state display",
				"Countdown to opening",
				"Countdown to last orders",
				"Countdown to closing",
				"Preparation-period guidance"
			]
		},
		{
			"uuid": "5bda47de-7e38-49c8-9b1f-f3f9b443e586",
			"title": "Build end-of-day summary screen",
			"description": "Create a readable daily results screen using the existing daily-cycle and economy data. It must support reviewing the completed day before starting the next one.",
			"category": "7f7c593f-f186-492d-ae50-28de1a5086f9",
			"steps": [
				"Daily income and tips",
				"Sales by drink",
				"Customers served and lost",
				"Breakages",
				"Stock usage",
				"Start next day flow"
			]
		},
		{
			"uuid": "6fda5ec3-f546-4707-b237-947c3c986928",
			"title": "Expand F10 daily-cycle controls",
			"description": "Add developer controls for lifecycle testing, demand inspection and modifier debugging without bypassing the normal underlying systems.",
			"category": "133c35c5-a004-493d-9c94-e32808a3d56e",
			"steps": [
				"Force lifecycle state",
				"Inspect demand curve",
				"Inspect active modifiers",
				"Apply and clear test modifier presets"
			]
		},
		{
			"uuid": "5811f211-c2af-454a-8ced-ec4d17072fab",
			"title": "Wire deferred modifier targets",
			"description": "Connect the generic modifier framework to the remaining planned customer-generation and visit variables. Keep all values configurable and data-driven.",
			"category": "133c35c5-a004-493d-9c94-e32808a3d56e",
			"steps": [
				"Customer-type weighting",
				"Group-size weighting",
				"Visit duration"
			]
		},
		{
			"uuid": "0f646078-2667-4e92-abd1-37da67560588",
			"title": "Expand daily-cycle diagnostics",
			"description": "Include enough lifecycle, demand and modifier context in exports to support future balancing, regression testing and bug investigation.",
			"category": "133c35c5-a004-493d-9c94-e32808a3d56e",
			"steps": [
				"State transition timeline",
				"Demand values over time",
				"Active modifier sources",
				"Daily totals",
				"Unexpected lifecycle transitions"
			]
		},
		{
			"uuid": "df758958-6486-4358-815d-36a3d176fd6a",
			"title": "Run full autonomous evening tests",
			"description": "Run complete service periods with no player assistance. Use several tables, finite stock, darts, staff, ordering, deliveries, closing and next-day transitions. Save diagnostic exports for every meaningful failure.",
			"category": "eeca6a8a-75ab-43fd-9fbd-ebbc4e31a0f6",
			"steps": [
				"Normal demand test",
				"High demand test",
				"Low-stock test",
				"Closing-time test",
				"Multi-day test"
			]
		},
		{
			"uuid": "d97225fa-2973-42bf-b0fa-a3415e3a3c54",
			"title": "Fix M menu stock refresh",
			"description": "The management menu is not reliably updating stock. Make it react to station usage, storage changes, deliveries, refills and new-day transitions.",
			"category": "2a4ca911-c5de-4b3d-861f-1d0b4d94ac3e",
			"steps": []
		},
		{
			"uuid": "37082c3f-1e13-481c-910d-acab943fa631",
			"title": "Correct bartender bar-side behaviour",
			"description": "The bartender currently collects drinks from the north side of the bar and walks around to the south side to place them. Keep staff behind the bar and use valid interaction/service positions.",
			"category": "8a325910-f48e-4fc9-b626-f8bac691f963",
			"steps": []
		},
		{
			"uuid": "8c19e6e7-95c0-4149-a7fc-d8e0177d3528",
			"title": "Harden global task-board behaviour",
			"description": "Investigate duplicate tasks, stale reservations, starvation, invalid carried items and tasks that become impossible after assignment. Improve diagnostics alongside fixes.",
			"category": "8a325910-f48e-4fc9-b626-f8bac691f963",
			"steps": [
				"Duplicate prevention",
				"Task viability recheck",
				"Reservation cleanup",
				"Carried-item recovery",
				"Idle-reason reporting"
			]
		},
		{
			"uuid": "61a484f1-10b3-4f85-ab42-ffbe7b0bc720",
			"title": "Test darts and seat-return edge cases",
			"description": "Confirm customers reserve darts correctly, retain their chair, return to it, release all reservations, and recover when the destination or route becomes invalid.",
			"category": "d112445c-3fd1-4c63-8754-b48ad52ce827",
			"steps": []
		},
		{
			"uuid": "ff296581-e2e5-411b-8685-c981923914cd",
			"title": "Targeted navigation reliability fixes",
			"description": "Do not perform the full navigation overhaul yet. Fix only navigation failures that stop customers or staff completing existing actions. Log stuck agents and recovery attempts.",
