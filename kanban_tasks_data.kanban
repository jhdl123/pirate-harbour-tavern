			"steps": []
		},
		{
			"uuid": "d07cb8e1-9128-4b66-98ae-fdc082f70ca6",
			"title": "Balance current simulation values",
			"description": "Use diagnostics rather than intuition alone to tune the fast testing values into a playable baseline while preserving easy test presets.",
